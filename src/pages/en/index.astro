---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { engine } from '../../data/engine';
import { jobs } from '../../data/resume';
---
<Base title="Kaiming Yi" description="Kaiming Yi (gameKnife) — graphics and game engine engineer in Chengdu, China. Author of gkNextEngine, a C++20 + Vulkan real-time path tracing engine.">
  <div class="shell wrap">
    <header class="head">
      <p class="marker">{site.location}</p>
      <h1>{site.name_en} <em>gameKnife</em></h1>
      <p class="lede">{site.headline_en}</p>
      <p class="creds">{site.credentials_en}</p>
      <div class="acts">
        <a class="btn btn-primary" href={engine.docs} rel="noopener" target="_blank">gkNextEngine</a>
        <a class="btn" href="/en/cv/">CV</a>
        <a class="btn" href="/blog/">Blog <span class="zh">(Chinese)</span></a>
      </div>
    </header>

    <section class="sec">
      <h2>{engine.name}</h2>
      <p>{engine.summary}</p>
      <ul class="metrics">
        {engine.metrics.map((m) => (
          <li>
            <b class="tabular">{m.value}<em>{m.unit}</em></b>
            <span>{m.label === '实时路径追踪' ? 'Real-time path tracing'
                 : m.label === '延迟渲染' ? 'Deferred rendering'
                 : m.label === '显存占用' ? 'VRAM footprint'
                 : 'First-party code'}</span>
          </li>
        ))}
      </ul>
      <p class="links">
        <a href={engine.repo} rel="noopener" target="_blank">Source on GitHub →</a>
        <a href={engine.docs} rel="noopener" target="_blank">Documentation →</a>
      </p>
    </section>

    <section class="sec">
      <h2>Experience</h2>
      <ol class="jobs">
        {jobs.map((j) => (
          <li><span class="p tabular">{j.period}</span><b>{j.company}</b><span class="t">{j.title}</span></li>
        ))}
      </ol>
      <p class="links"><a href="/en/cv/">Full CV →</a></p>
    </section>

    <section class="sec">
      <h2>Elsewhere</h2>
      <p class="links">
        {site.social.filter((s) => s.href.startsWith('http')).map((s) => (
          <a href={s.href} rel="me noopener" target="_blank">{s.label === '知乎' ? 'Zhihu' : s.label === 'B 站' ? 'Bilibili' : s.label} →</a>
        ))}
        <a href={`mailto:${site.email}`}>{site.email} →</a>
      </p>
    </section>

    <p class="note">
      Most writing on this site is in Chinese. <a href="/">中文版 →</a>
    </p>
  </div>
</Base>
<style>
  .wrap { padding-block: 4rem 2rem; max-width: 820px; }
  h1 { font-size: clamp(2rem, 5.5vw, 2.9rem); margin-top: .6rem; display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap; }
  h1 em { font-family: var(--font-mono); font-style: normal; font-size: .44em; font-weight: 500; color: var(--muted); }
  .lede { margin: 1rem 0 0; font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; color: var(--text); max-width: 34ch; }
  .creds { margin: .7rem 0 0; color: var(--muted); font-size: .95rem; }
  .acts { display: flex; gap: .55rem; margin-top: 1.8rem; flex-wrap: wrap; }
  .zh { font-size: .82em; opacity: .65; }
  .sec { padding-top: 2.4rem; margin-top: 2.4rem; border-top: 1px solid var(--line); }
  h2 { font-size: 1.3rem; }
  .sec > p { margin: .9rem 0 0; color: var(--text-2); }
  .metrics { list-style: none; padding: 0; margin: 1.4rem 0 0; display: grid; gap: 1px;
             grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
             background: var(--line); border: 1px solid var(--line); border-radius: 11px; overflow: hidden; }
  .metrics li { background: var(--surface); padding: .95rem 1.05rem 1.1rem; display: flex; flex-direction: column; gap: .3rem; }
  .metrics b { font-family: var(--font-display); font-size: 1.55rem; font-weight: 800; color: var(--accent);
               letter-spacing: -.03em; display: flex; align-items: baseline; gap: .2rem; }
  .metrics b em { font-style: normal; font-size: .46em; font-weight: 600; }
  .metrics span { font-size: .8rem; color: var(--muted); }
  .jobs { list-style: none; padding: 0; margin: 1.3rem 0 0; display: grid; gap: .55rem; }
  .jobs li { display: grid; grid-template-columns: 130px auto 1fr; gap: .9rem; align-items: baseline; font-size: .9rem; }
  .p { font-family: var(--font-mono); font-size: .74rem; color: var(--accent); }
  .jobs b { font-weight: 600; }
  .t { color: var(--muted); font-size: .84rem; }
  .links { display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; margin-top: 1.2rem !important; font-size: .88rem; }
  .links a { text-decoration: none; }
  .note { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line-soft); font-size: .85rem; color: var(--muted); }
  @media (max-width: 620px) { .jobs li { grid-template-columns: 1fr; gap: .15rem; } }
</style>
