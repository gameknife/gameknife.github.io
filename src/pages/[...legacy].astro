---
// 存量文章按线上原始路径出页 —— 十年外链与搜索权重全押在这里，
// scripts/verify-urls.mjs 会在 CI 里逐条核对。
import { render } from 'astro:content';
import Post from '../layouts/Post.astro';
import { allPosts, postUrl, relatedPosts } from '../lib/posts';

export async function getStaticPaths() {
  const posts = await allPosts();
  return Promise.all(
    posts.map(async (post) => ({
      params: { legacy: postUrl(post).replace(/^\/|\/$/g, '') },
      props: { post, related: await relatedPosts(post) },
    })),
  );
}

const { post, related } = Astro.props;
const { Content } = await render(post);
---
<Post post={post} related={related}>
  <Content />
</Post>
