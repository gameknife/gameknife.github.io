---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import Tag from '../../../components/blog/Tag.astro';
import { allTags, listedPosts } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await listedPosts();
  const tags = await allTags();
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---
<Base title={`#${tag}`} description={`标签 ${tag} 下的 ${posts.length} 篇文章。`}>
  <div class="shell wrap">
    <div class="marker">Tag</div>
    <h1 class="tag-title"><Tag tag={tag} asLink={false} size="lg" /></h1>
    <p class="lede">{posts.length} 篇 · <a href="/blog/">回到全部文章</a></p>
    <div class="grid">
      {posts.map((p) => <PostCard post={p} />)}
    </div>
  </div>
</Base>

<style>
  .wrap { padding-block: 3.5rem 2rem; }
  .tag-title { margin-top: .6rem; }
  .tag-title :global(.tag-chip) { font-size: clamp(1.4rem, 4vw, 1.85rem); padding: .25rem .85rem; border-radius: 8px; }
  .lede { margin: 1rem 0 2.5rem; color: var(--muted); font-size: .92rem; }
  .lede a { color: var(--accent); }
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
</style>
