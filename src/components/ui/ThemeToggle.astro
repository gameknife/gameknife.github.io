---
---
<button type="button" class="tt" onclick="window.__toggleTheme()" aria-label="切换深色 / 浅色模式" title="切换深色 / 浅色模式">
  <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
  <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2.2v2.2M12 19.6v2.2M4.4 4.4l1.6 1.6M18 18l1.6 1.6M2.2 12h2.2M19.6 12h2.2M4.4 19.6l1.6-1.6M18 6l1.6-1.6"/>
  </svg>
</button>
<style>
  .tt {
    display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px; padding: 0;
    border: 0; background: none; color: var(--faint);
    cursor: pointer; transition: color .2s;
  }
  .tt:hover { color: var(--ink); }
  .tt svg { width: 15px; height: 15px; }
  .sun { display: block; }
  .moon { display: none; }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .sun { display: none; }
    :root:not([data-theme='dark']) .moon { display: block; }
  }
  :root[data-theme='light'] .sun { display: none; }
  :root[data-theme='light'] .moon { display: block; }
  :root[data-theme='dark'] .sun { display: block; }
  :root[data-theme='dark'] .moon { display: none; }
</style>
