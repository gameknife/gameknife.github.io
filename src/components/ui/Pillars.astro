---
import { engine } from '../../data/engine';
---
<div class="p">
  {engine.pillars.map((g) => (
    <section>
      <h3>{g.heading}</h3>
      <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
    </section>
  ))}
</div>
<style>
  /* 两列，靠细线分栏而不是卡片。四列在 1280 下会溢出。 */
  .p {
    margin: 2.2rem 0 !important;
    display: grid;
    gap: 2.4rem 3rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  section { margin: 0 !important; padding-top: 1.1rem; border-top: 1px solid var(--line); }
  h3 {
    margin: 0 !important;
    font-family: var(--font-mono) !important;
    font-size: .72rem !important;
    font-weight: 500;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent);
    font-variation-settings: normal;
  }
  ul { margin: 1rem 0 0 !important; padding: 0; list-style: none; display: grid; gap: .75rem; }
  li {
    margin: 0 !important;
    font-size: .87rem;
    line-height: 1.72;
    color: var(--ink-2);
    padding-left: 1rem;
    position: relative;
  }
  li::before {
    content: '';
    position: absolute; left: 0; top: .72em;
    width: 4px; height: 1px; background: var(--faint);
  }
</style>
