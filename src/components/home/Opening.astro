---
import { site } from '../../data/site';
---

<section class="op">
  <div class="shell">
    <p class="who">
      <span>{site.name_zh}</span>
      <i>{site.name_en} · gameKnife</i>
    </p>

    <h1>
      我写引擎，<br />
      也画画。
    </h1>

    <p class="thesis">
      两件事其实是同一件 —— 都是在琢磨<em>光打在东西上会是什么样</em>。
      区别只是从前用笔画，现在用 GPU 画。
    </p>

    <p class="prov wall-label">
      <b>十五年实时图形与游戏开发</b>
      <i>腾讯天美 · 完美世界 · 永航科技 · 搜狐畅游</i>
      <a class="quiet-link" href="/resume/">完整履历</a>
    </p>
  </div>
</section>

<style>
  .op {
    padding-block: clamp(5rem, 16vh, 9rem) clamp(3.5rem, 9vh, 6rem);
  }

  .who {
    margin: 0 0 clamp(2rem, 6vh, 3.5rem);
    display: flex;
    align-items: baseline;
    gap: .9rem;
    flex-wrap: wrap;
  }
  .who span {
    font-family: var(--font-mono);
    font-size: .74rem;
    letter-spacing: .3em;
    color: var(--muted);
    text-transform: none;
  }
  .who i {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: .68rem;
    letter-spacing: .1em;
    color: var(--faint);
  }

  h1 {
    font-size: clamp(2.9rem, 10vw, 6.2rem);
    font-weight: 500;
    font-variation-settings: 'opsz' 144, 'SOFT' 55, 'WONK' 1;
    letter-spacing: -.035em;
    line-height: .98;
  }

  .thesis {
    margin: clamp(1.8rem, 5vh, 2.8rem) 0 0;
    max-width: 34ch;
    font-size: clamp(1rem, 2.4vw, 1.18rem);
    line-height: 1.75;
    color: var(--ink-2);
  }
  .thesis em {
    font-style: normal;
    color: var(--ink);
    box-shadow: inset 0 -1px 0 var(--accent-dim);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .prov {
    margin-top: clamp(2.5rem, 7vh, 4rem);
    align-items: baseline;
    gap: .35rem 1.1rem;
  }
</style>
