---
import { Image } from 'astro:assets';
import { engine } from '../../data/engine';
import confroom from '../../assets/engine/confroom.webp';
import editor from '../../assets/engine/gknexteditor.webp';
---

<section class="th">
  <hr class="rule" />

  <div class="shell head">
    <p class="marker">一 · 引擎</p>
    <h2>{engine.name}</h2>
    <p class="say">
      不背历史包袱，从今天的现代GPU出发重新写一遍渲染器 ——
      它会长成什么样？<br />
      2024 年 5 月起，我一直在回答这个问题。
    </p>
  </div>

  <figure class="plate wide">
    <Image src={confroom} alt="会议室场景的实时路径追踪结果" widths={[900, 1600, 2200]} sizes="(max-width: 1180px) 100vw, 1180px" loading="lazy" />
    <figcaption class="wall-label">
      <b>会议室</b>
      <i>实时路径追踪</i>
      <span>1 spp · 时域复用 · 降噪 · TAAU / DLSS / FSR</span>
    </figcaption>
  </figure>

  <div class="shell body">
    <dl class="nums">
      {engine.metrics.map((m) => (
        <div>
          <dt class="tabular">{m.value}<em>{m.unit}</em></dt>
          <dd>{m.label}</dd>
        </div>
      ))}
    </dl>

    <div class="note">
      <p>
        给自己定的唯一硬指标是<strong>核心代码不超过 5 万行</strong>。
        引擎腐烂的方式几乎都一样：功能越加越多，抽象越叠越厚，最后没人敢动核心。
        限制代码量就是限制抽象层数 —— 每加一个特性，都要先回答「能不能不加这一层」。
      </p>
      <p class="links">
        <a class="quiet-link" href="/engine/">项目背后</a>
        <a class="quiet-link" href={engine.docs} rel="noopener" target="_blank">文档站</a>
        <a class="quiet-link" href={engine.repo} rel="noopener" target="_blank">源码</a>
      </p>
    </div>
  </div>

  <figure class="plate shell narrow">
    <Image src={editor} alt="gkNextEditor 可视化编辑器" widths={[780, 1560]} sizes="(max-width: 780px) 100vw, 780px" loading="lazy" />
    <figcaption class="wall-label">
      <b>gkNextEditor</b>
      <i>ImGui 低代码编辑器</i>
      <span>节点化材质图 · cvar 实时调优</span>
    </figcaption>
  </figure>
</section>

<style>
  .th { padding-block: clamp(3.5rem, 9vh, 6rem) 0; }

  .head { padding-block: clamp(2.5rem, 7vh, 4rem) clamp(2rem, 5vh, 3rem); }
  h2 {
    margin-top: 1.1rem;
    font-size: clamp(2rem, 6vw, 3.4rem);
    font-weight: 500;
    font-variation-settings: 'opsz' 144, 'SOFT' 50, 'WONK' 1;
    letter-spacing: -.03em;
  }
  .say {
    margin: 1.4rem 0 0;
    max-width: 40ch;
    font-size: 1.02rem;
    line-height: 1.8;
    color: var(--ink-2);
  }

  /* 画廊挂法：图放到最大，边距只留呼吸。
     只清 margin-block —— 写成 margin: 0 会把 .shell 的 margin-inline: auto 一起干掉，
     figure 就不再居中，整块往左偏一个 (viewport - shell) / 2。 */
  .plate { margin-block: 0; }
  .plate.wide {
    max-width: var(--shell);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .plate.narrow { margin-top: clamp(3rem, 8vh, 5rem); }
  /* 展签跟着作品走，不跟着栏宽走 —— 墙签贴在画下面，不会比画还宽 */
  .plate.narrow > * { max-width: 780px; }
  .plate :global(img) {
    width: 100%;
    border-radius: 2px;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    padding-block: clamp(2.8rem, 8vh, 4.5rem) 0;
    align-items: start;
  }

  .nums { margin: 0; display: grid; gap: 1.6rem; }
  .nums div { display: flex; flex-direction: column; gap: .1rem; }
  .nums dt {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    font-weight: 500;
    font-variation-settings: 'opsz' 144, 'SOFT' 40, 'WONK' 1;
    letter-spacing: -.04em;
    line-height: 1;
    display: flex;
    align-items: baseline;
    gap: .25rem;
  }
  .nums dt em {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: .32em;
    letter-spacing: .1em;
    color: var(--muted);
  }
  .nums dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: .72rem;
    letter-spacing: .06em;
    color: var(--faint);
  }

  .note p { margin: 0; font-size: .97rem; line-height: 1.85; color: var(--ink-2); max-width: 52ch; }
  .note strong { color: var(--ink); font-weight: 600; }
  .links { margin-top: 1.8rem !important; display: flex; flex-wrap: wrap; gap: 1.4rem; }

  @media (max-width: 820px) {
    .body { grid-template-columns: 1fr; gap: 2.2rem; }
    .nums { grid-template-columns: 1fr 1fr; gap: 1.4rem 1rem; }
  }
</style>
