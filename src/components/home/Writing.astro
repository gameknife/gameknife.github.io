---
import { featuredPosts, isoDate, listedPosts, postUrl } from '../../lib/posts';
import { site } from '../../data/site';
const posts = await featuredPosts(3);
const total = (await listedPosts()).length;
---
<section class="wr">
  <hr class="rule" />
  <div class="shell">
    <div class="head">
      <p class="marker">写下来的</p>
      <h2>笔记</h2>
    </div>

    <ol class="list">
      {posts.map((p) => (
        <li>
          <a href={postUrl(p)}>
            <time class="d tabular" datetime={isoDate(p.data.date)}>{isoDate(p.data.date)}</time>
            <span class="t">
              {p.data.draft && <span class="badge-draft">草稿</span>}
              {p.data.title}
            </span>
            <span class="x">{p.data.description}</span>
            <span class="c">{site.categories[p.data.category].label}</span>
          </a>
        </li>
      ))}
    </ol>

    <p class="more">
      <a class="quiet-link" href="/blog/">全部 {total} 篇 · 最早写于 2013 年</a>
    </p>
  </div>
</section>
<style>
  .wr { padding-block: clamp(4rem, 11vh, 7rem) 0; }
  .head { padding-block: clamp(2.5rem, 7vh, 4rem) clamp(1.5rem, 4vh, 2.5rem); }
  h2 {
    margin-top: 1.1rem;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    font-weight: 500;
    font-variation-settings: 'opsz' 144, 'SOFT' 50, 'WONK' 1;
    letter-spacing: -.03em;
  }

  .list { list-style: none; margin: 0; padding: 0; }
  .list li { border-top: 1px solid var(--line-soft); }
  .list li:last-child { border-bottom: 1px solid var(--line-soft); }
  .list a {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr) auto;
    gap: .4rem 2rem;
    align-items: baseline;
    padding-block: 1.5rem;
    text-decoration: none;
    transition: opacity .2s;
  }
  .list a:hover { opacity: .62; }
  .d { font-family: var(--font-mono); font-size: .72rem; color: var(--faint); letter-spacing: .04em; }
  .t {
    font-family: var(--font-display);
    font-size: 1.24rem;
    font-weight: 500;
    font-variation-settings: 'SOFT' 40, 'WONK' 1;
    letter-spacing: -.015em;
    line-height: 1.3;
  }
  .badge-draft {
    font-family: var(--font-mono);
    font-size: .68rem;
    font-weight: 500;
    letter-spacing: .04em;
    padding: .1rem .4rem;
    border-radius: 4px;
    border: 1px dashed var(--accent-dim);
    color: var(--accent);
    background: var(--surface-2);
    margin-right: .5rem;
    vertical-align: 2px;
    display: inline-block;
  }
  .x {
    grid-column: 2;
    font-size: .875rem;
    line-height: 1.7;
    color: var(--muted);
    max-width: 56ch;
    display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .c { grid-row: 1; grid-column: 3; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .1em; color: var(--faint); }
  .more { margin: clamp(2rem, 5vh, 3rem) 0 0; }

  @media (max-width: 720px) {
    .list a { grid-template-columns: 1fr auto; gap: .35rem 1rem; }
    .d, .x { grid-column: 1 / -1; }
  }
</style>
